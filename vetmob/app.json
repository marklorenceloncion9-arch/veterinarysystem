{
  "expo": {
    "name": "ALAGANG ELSALVET",
    "slug": "vetmob",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/elsalvet-logo.png",
    "scheme": "vetmob",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#16324F",
      "translucent": true
    },
    "android": {
      "package": "com.petharmony.vetmob",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/elsalvet-logo.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "backgroundColor": "#F5F7FA",
        "barStyle": "dark-content"
      }
    },
    "ios": {
      "bundleIdentifier": "com.petharmony.vetmob",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow ALAGANG ELSALVET to use your location to pin your Home Services meeting place inside El Salvador City.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "googlemaps"
        ]
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/elsalvet-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/elsalvet-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ALAGANG ELSALVET to access your camera to scan animal QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ALAGANG ELSALVET to use your location to pin your Home Services meeting place inside El Salvador City."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b79d8035-1122-4ded-932d-43eea15a6ccc"
      }
    },
    "owner": "lorenceywa",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b79d8035-1122-4ded-932d-43eea15a6ccc"
    }
  }
}
