EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dlscihgvx
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=vetmob
EXPO_PUBLIC_MAPBOX_TOKEN=
# Required for installable builds (EAS). Use your public API URL.
# EXPO_PUBLIC_API_BASE_URL=https://your-domain.com/Project/vetweb/public

# Pusher public key and cluster (must match vetweb/.env PUSHER_APP_KEY / PUSHER_APP_CLUSTER)
EXPO_PUBLIC_PUSHER_APP_KEY=
EXPO_PUBLIC_PUSHER_APP_CLUSTER=ap1

# For EAS Build, set these as Expo project secrets instead of committing .env:
# eas secret:create --scope project --name EXPO_PUBLIC_API_BASE_URL --value "https://your-api-url"
# eas secret:create --scope project --name EXPO_PUBLIC_PUSHER_APP_KEY --value "your-pusher-key"
# eas secret:create --scope project --name EXPO_PUBLIC_PUSHER_APP_CLUSTER --value "ap1"
